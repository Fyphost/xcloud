# Copy to .env and adjust.
PORT=3000
HOST=0.0.0.0
SITE_NAME=xCloud
# Public URL used for share links (leave empty to use the request Host header)
BASE_URL=
DATA_DIR=data

# Storage limits
MAX_FILE_SIZE_MB=500
USER_QUOTA_MB=2048
ALLOW_REGISTRATION=true

# Download page
DOWNLOAD_WAIT_SECONDS=15
DOWNLOAD_TICKET_TTL_MINUTES=60

# Ads: snippets live in ads/<slot>.html. Show dashed placeholders for empty slots?
ADS_DIR=ads
SHOW_AD_PLACEHOLDERS=true

# Set both to true when running behind HTTPS / a reverse proxy (nginx, Cloudflare...)
SECURE_COOKIES=false
TRUST_PROXY=false

SESSION_TTL_DAYS=7
UPLOAD_TIMEOUT_MINUTES=120
